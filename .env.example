# Copy to .env.local and fill in. Never commit real values.
# Production values live in Vercel → Project → Settings → Environment Variables.

# Stage 2 — Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stage 2 — Google Cloud
# OAuth client (same values as in Supabase → Auth → Providers → Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key restricted to "YouTube Data API v3"
YOUTUBE_API_KEY=

# Only these Google accounts may sign in (comma-separated). Personal-only app.
ALLOWED_EMAILS=

# Stage 3+ — shared secret for GitHub Actions → /api/cron/*
CRON_SECRET=

# Stage 4+ — live-stream alerts
WEBSUB_SECRET=
DISCORD_WEBHOOK_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
