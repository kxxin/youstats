# Copy to .env.local and fill in. Never commit real values.
# Production values live in Vercel → Project → Settings → Environment Variables.

# Stage 0+ — public site URL (used for OAuth callbacks and WebSub)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stage 2+ — Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stage 2+ — Google Cloud (YouTube Data API v3 + OAuth client)
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stage 3+ — shared secret for GitHub Actions → /api/cron/*
CRON_SECRET=

# Stage 4+ — live-stream alerts
WEBSUB_SECRET=
DISCORD_WEBHOOK_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
