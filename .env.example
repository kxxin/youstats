# Copy to .env.local and fill in. Never commit real values.
# Production values live in Vercel → Project → Settings → Environment Variables.

# Stage 2 — Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stage 2 — Google Cloud
# OAuth client (same values as in Supabase → Auth → Providers → Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key restricted to "YouTube Data API v3"
YOUTUBE_API_KEY=

# Only these Google accounts may sign in (comma-separated). Personal-only app.
ALLOWED_EMAILS=

# Stage 3+ — shared secret for GitHub Actions → /api/cron/*
CRON_SECRET=

# Stage 4 — live-stream alerts
# Your site's public URL (WebSub callback). Optional on Vercel production.
NEXT_PUBLIC_SITE_URL=
# Random string used to sign YouTube WebSub pushes
WEBSUB_SECRET=
# Web push keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Time zone used in "scheduled for …" alerts
ALERT_TIMEZONE=Asia/Kuala_Lumpur
